# Pancake V3 full-protocol deployment on Base mainnet.
# Replace every <...> value before sourcing this file.

export RPC_URL="https://mainnet.base.org"
export PRIVATE_KEY="<DEPLOYER_PRIVATE_KEY>"

# Roles.
export OWNER="<OWNER_OR_MULTISIG>"
export OPERATOR="<AUTOMATION_OPERATOR>"
export WITHDRAWER="<AUTOMATION_WITHDRAWER>"
export STAKING_WITHDRAWER="<STAKING_WITHDRAWER>"
export ORACLE_EMERGENCY_ADMIN="0x0000000000000000000000000000000000000000"
export VAULT_EMERGENCY_ADMIN="0x0000000000000000000000000000000000000000"

# Optional external swap executors for V3Utils, leverage, AutoRange, AutoExit, and staking-manager recovery flows.
export UNIVERSAL_ROUTER="0x0000000000000000000000000000000000000000"
export ZEROX_ALLOWANCE_HOLDER="0x0000000000000000000000000000000000000000"

# Chain constants also consumed by script/VerifyPancakeDeployment.s.sol.
export PANCAKE_NPM="0x46A15B0b27311cedF172AB29E4f4766fbE7F4364"
export PANCAKE_MASTER_CHEF_V3="0xC6A2Db661D5a5690172d8eB0a7DEA2d3008665A3"
export CAKE="0x3055913c90Fcc1A6CE9a358911721eEb942013A1"
export WETH="0x4200000000000000000000000000000000000006"
export USDC="0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"

# Vault defaults used by script/DeployPancakeBase.s.sol.
export VAULT_ASSET="$USDC"
export REFERENCE_TOKEN="$WETH"
export CHAINLINK_REFERENCE_TOKEN="0x0000000000000000000000000000000000000000"
export VAULT_NAME="Revert Lend Base USDC"
export VAULT_SYMBOL="rlBaseUSDC"
export SET_VAULT_GAUGE_MANAGER="true"

# Oracle config.
# Modes: 1=CHAINLINK_TWAP_VERIFY, 2=TWAP_CHAINLINK_VERIFY, 3=CHAINLINK, 4=TWAP.
# Base Chainlink feeds: ETH/USD and USDC/USD. USDC is verified against the Pancake WETH/USDC 0.05% TWAP pool.
export ETH_USD_FEED="0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70"
export USDC_USD_FEED="0x7e860098F58bBFC8648a4311b374B1D669a2bc6B"
export WETH_USDC_PANCAKE_POOL="0xB775272E537cc670C65DC852908aD47015244EaF"
export ORACLE_TOKENS="$WETH,$USDC"
export ORACLE_FEEDS="$ETH_USD_FEED,$USDC_USD_FEED"
export ORACLE_MAX_FEED_AGES="86400,86400"
export ORACLE_TWAP_POOLS="0x0000000000000000000000000000000000000000,$WETH_USDC_PANCAKE_POOL"
export ORACLE_TWAP_SECONDS="0,60"
export ORACLE_MODES="3,1"
export ORACLE_MAX_DIFFERENCES="0,200"
export MAX_POOL_PRICE_DIFFERENCE="200"
# export SEQUENCER_UPTIME_FEED="<BASE_CHAINLINK_SEQUENCER_UPTIME_FEED>"

# Risk config. Amounts are USDC base units, so 1 USDC = 1000000.
export COLLATERAL_TOKENS="$WETH,$USDC"
export COLLATERAL_FACTORS_BPS="<WETH_COLLATERAL_BPS>,<USDC_COLLATERAL_BPS>"
export COLLATERAL_VALUE_LIMIT_FACTORS_BPS="<WETH_VALUE_LIMIT_BPS>,<USDC_VALUE_LIMIT_BPS>"
export GLOBAL_LEND_LIMIT="<GLOBAL_LEND_LIMIT_USDC_UNITS>"
export GLOBAL_DEBT_LIMIT="<GLOBAL_DEBT_LIMIT_USDC_UNITS>"
export DAILY_LEND_INCREASE_LIMIT_MIN="<DAILY_LEND_INCREASE_LIMIT_USDC_UNITS>"
export DAILY_DEBT_INCREASE_LIMIT_MIN="<DAILY_DEBT_INCREASE_LIMIT_USDC_UNITS>"
export MIN_LOAN_SIZE="<MIN_LOAN_SIZE_USDC_UNITS>"
export RESERVE_FACTOR_BPS="1000"
export RESERVE_PROTECTION_FACTOR_BPS="500"

# Pancake reward compounding and staked pool support.
export CAKE_WETH_POOL="0x433fdEe2AE9cea22a78499F8F8592ffD5D4E60c9"
export CAKE_USDC_POOL="0xBf1713B92F4212F0fAC0078e2cea7E182D40078B"
export PANCAKE_REWARD_BASE_TOKENS="$WETH,$USDC"
export PANCAKE_REWARD_BASE_POOLS="$CAKE_WETH_POOL,$CAKE_USDC_POOL"
export PANCAKE_STAKING_POOLS="$WETH_USDC_PANCAKE_POOL"

# Fill these from the DeployPancakeBase log before running VerifyPancakeDeployment.
export INTEREST_RATE_MODEL="<DEPLOYED_INTEREST_RATE_MODEL>"
export ORACLE="<DEPLOYED_ORACLE>"
export VAULT="<DEPLOYED_VAULT>"
export FLASHLOAN_LIQUIDATOR="<DEPLOYED_FLASHLOAN_LIQUIDATOR>"
export V3_UTILS="<DEPLOYED_V3_UTILS>"
export LEVERAGE_TRANSFORMER="<DEPLOYED_LEVERAGE_TRANSFORMER>"
export AUTO_RANGE="<DEPLOYED_AUTO_RANGE>"
export AUTO_EXIT="<DEPLOYED_AUTO_EXIT>"
export PANCAKE_STAKING_MANAGER="<DEPLOYED_PANCAKE_STAKING_MANAGER>"
