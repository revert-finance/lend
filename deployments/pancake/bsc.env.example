# Pancake V3 full-protocol deployment on BSC mainnet.
# Replace every <...> value before sourcing this file.

export RPC_URL="https://bsc-dataseed.binance.org"
export PRIVATE_KEY="<DEPLOYER_PRIVATE_KEY>"

# Roles.
export OWNER="<OWNER_OR_MULTISIG>"
export OPERATOR="<AUTOMATION_OPERATOR>"
export WITHDRAWER="<AUTOMATION_WITHDRAWER>"
export STAKING_WITHDRAWER="<STAKING_WITHDRAWER>"
export ORACLE_EMERGENCY_ADMIN="0x0000000000000000000000000000000000000000"
export VAULT_EMERGENCY_ADMIN="0x0000000000000000000000000000000000000000"

# Optional external swap executors for V3Utils, leverage, AutoRange, AutoExit, and staking-manager recovery flows.
export UNIVERSAL_ROUTER="0x0000000000000000000000000000000000000000"
export ZEROX_ALLOWANCE_HOLDER="0x0000000000000000000000000000000000000000"

# Chain constants also consumed by script/VerifyPancakeDeployment.s.sol.
export PANCAKE_NPM="0x46A15B0b27311cedF172AB29E4f4766fbE7F4364"
export PANCAKE_MASTER_CHEF_V3="0x556B9306565093C855AEA9AE92A594704c2Cd59e"
export CAKE="0x0E09FaBB73Bd3Ade0a17ECC321fD13a19e81cE82"
export WBNB="0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c"
export USDT="0x55d398326f99059fF775485246999027B3197955"

# Vault defaults used by script/DeployPancakeBsc.s.sol.
export VAULT_ASSET="$USDT"
export REFERENCE_TOKEN="$WBNB"
export CHAINLINK_REFERENCE_TOKEN="0x0000000000000000000000000000000000000000"
export VAULT_NAME="Revert Lend BSC USDT"
export VAULT_SYMBOL="rlBscUSDT"
export SET_VAULT_GAUGE_MANAGER="true"

# Oracle config.
# Modes: 1=CHAINLINK_TWAP_VERIFY, 2=TWAP_CHAINLINK_VERIFY, 3=CHAINLINK, 4=TWAP.
# BSC Chainlink feeds: BNB/USD and USDT/USD. USDT is verified against the Pancake WBNB/USDT 0.01% TWAP pool.
export BNB_USD_FEED="0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE"
export USDT_USD_FEED="0xB97Ad0E74fa7d920791E90258A6E2085088b4320"
export WBNB_USDT_PANCAKE_POOL="0x172fcD41E0913e95784454622d1c3724f546f849"
export ORACLE_TOKENS="$WBNB,$USDT"
export ORACLE_FEEDS="$BNB_USD_FEED,$USDT_USD_FEED"
export ORACLE_MAX_FEED_AGES="86400,86400"
export ORACLE_TWAP_POOLS="0x0000000000000000000000000000000000000000,$WBNB_USDT_PANCAKE_POOL"
export ORACLE_TWAP_SECONDS="0,60"
export ORACLE_MODES="3,1"
export ORACLE_MAX_DIFFERENCES="0,200"
export MAX_POOL_PRICE_DIFFERENCE="200"

# Risk config. Amounts are USDT base units, so 1 USDT = 1000000000000000000.
export COLLATERAL_TOKENS="$WBNB,$USDT"
export COLLATERAL_FACTORS_BPS="<WBNB_COLLATERAL_BPS>,<USDT_COLLATERAL_BPS>"
export COLLATERAL_VALUE_LIMIT_FACTORS_BPS="<WBNB_VALUE_LIMIT_BPS>,<USDT_VALUE_LIMIT_BPS>"
export GLOBAL_LEND_LIMIT="<GLOBAL_LEND_LIMIT_USDT_UNITS>"
export GLOBAL_DEBT_LIMIT="<GLOBAL_DEBT_LIMIT_USDT_UNITS>"
export DAILY_LEND_INCREASE_LIMIT_MIN="<DAILY_LEND_INCREASE_LIMIT_USDT_UNITS>"
export DAILY_DEBT_INCREASE_LIMIT_MIN="<DAILY_DEBT_INCREASE_LIMIT_USDT_UNITS>"
export MIN_LOAN_SIZE="<MIN_LOAN_SIZE_USDT_UNITS>"
export RESERVE_FACTOR_BPS="1000"
export RESERVE_PROTECTION_FACTOR_BPS="500"

# Pancake reward compounding and staked pool support.
export CAKE_WBNB_POOL="0x133B3D95bAD5405d14d53473671200e9342896BF"
export CAKE_USDT_POOL="0x7f51c8AaA6B0599aBd16674e2b17FEc7a9f674A1"
export PANCAKE_REWARD_BASE_TOKENS="$WBNB,$USDT"
export PANCAKE_REWARD_BASE_POOLS="$CAKE_WBNB_POOL,$CAKE_USDT_POOL"
export PANCAKE_STAKING_POOLS="$WBNB_USDT_PANCAKE_POOL"

# Fill these from the DeployPancakeBsc log before running VerifyPancakeDeployment.
export INTEREST_RATE_MODEL="<DEPLOYED_INTEREST_RATE_MODEL>"
export ORACLE="<DEPLOYED_ORACLE>"
export VAULT="<DEPLOYED_VAULT>"
export FLASHLOAN_LIQUIDATOR="<DEPLOYED_FLASHLOAN_LIQUIDATOR>"
export V3_UTILS="<DEPLOYED_V3_UTILS>"
export LEVERAGE_TRANSFORMER="<DEPLOYED_LEVERAGE_TRANSFORMER>"
export AUTO_RANGE="<DEPLOYED_AUTO_RANGE>"
export AUTO_EXIT="<DEPLOYED_AUTO_EXIT>"
export PANCAKE_STAKING_MANAGER="<DEPLOYED_PANCAKE_STAKING_MANAGER>"
